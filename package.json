{
  "name": "colombian-shooter-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A minimal browser-extension scaffold built with Extension.js and TypeScript.",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "extension": "^4.0.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "assets:figma": "bun scripts/figma-export.mjs",
    "dev": "bun run css && extension dev",
    "start": "bun run css && extension start",
    "build": "bun run css && extension build",
    "preview": "bun run css && extension preview",
    "build:chrome": "bun run css && extension build --browser chrome",
    "build:firefox": "bun run css && extension build --browser firefox",
    "build:edge": "bun run css && extension build --browser edge",
    "css": "tailwindcss -i ./tailwind.css -o ./src/theme.css",
    "css:watch": "tailwindcss -i ./tailwind.css -o ./src/theme.css --watch"
  }
}
