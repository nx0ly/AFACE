{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "firefox:browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "Page Pause",
  "description": "A focused interstitial that pauses any webpage until you continue.",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "64": "images/icon.png",
    "128": "images/icon.png"
  },
  "chromium:action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_title": "Page Pause"
  },
  "firefox:browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_title": "Page Pause"
  },
  "chromium:background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "firefox:background": {
    "scripts": [
      "background.ts"
    ]
  },
  "chromium:permissions": [
    "storage"
  ],
  "firefox:permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "punishment.css"
      ],
      "js": [
        "index.ts"
      ],
      "run_at": "document_start"
    }
  ],
  "chromium:web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "pages/blocked.html",
        "pages/games.html",
        "pages/minigames/tejo.html",
        "pages/minigames/roullete_wheel.html",
        "pages/minigames/shop.html",
        "pages/blocked.js",
        "punishments/registry.js",
        "punishments/overlay.js",
        "punishments/arepa-rain.js",
        "punishments/mango-harvest.js",
        "punishments/bank-queue.js",
        "punishments/penance-typing.js",
        "pages/minigames/tejo.js",
        "pages/minigames/roullete_wheel.js",
        "pages/minigames/shop.js",
        "pages/minigames/adivina.html",
        "pages/minigames/adivina.js",
        "images/arepa.png",
        "images/mango.png",
        "images/borders/top.webp",
        "images/borders/bottom.webp",
        "images/borders/left.webp",
        "images/borders/right.webp",
        "images/borders/top_left_2.webp",
        "images/borders/top_right.webp",
        "images/borders/bottom_left.webp",
        "images/borders/bottom_right_2.webp"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "firefox:web_accessible_resources": [
    "theme.css",
    "pages/blocked.html",
    "pages/games.html",
    "pages/minigames/tejo.html",
    "pages/minigames/roullete_wheel.html",
    "pages/minigames/shop.html",
    "pages/blocked.js",
    "punishments/registry.js",
    "punishments/overlay.js",
    "punishments/arepa-rain.js",
    "punishments/mango-harvest.js",
    "punishments/bank-queue.js",
    "punishments/penance-typing.js",
    "pages/minigames/tejo.js",
    "pages/minigames/roullete_wheel.js",
    "pages/minigames/shop.js",
    "pages/minigames/adivina.html",
    "pages/minigames/adivina.js",
    "images/arepa.png",
    "images/mango.png",
    "images/borders/top.webp",
    "images/borders/bottom.webp",
    "images/borders/left.webp",
    "images/borders/right.webp",
    "images/borders/top_left_2.webp",
    "images/borders/top_right.webp",
    "images/borders/bottom_left.webp",
    "images/borders/bottom_right_2.webp"
  ]
}
